# مثال بيئة تطوير محلي فقط — لا قيم حقيقية هنا. انسخه إلى .env ولا تدفعه لِGit.

# ---- API ----
NODE_ENV=development
API_PORT=3001
API_BASE_PATH=/api/v1
CORRELATION_HEADER=x-correlation-id

# ---- PostgreSQL (packages/db) ----
POSTGRES_USER=alzad_dev
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=alzad_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://alzad_dev:change-me-dev-only@localhost:5432/alzad_platform?schema=public

# ---- Auth (dev secrets only — لا تُستخدم في أي بيئة حقيقية) ----
SESSION_TOKEN_PEPPER=dev-only-pepper-change-me
PASSWORD_HASH_SALT_ROUNDS=12

# مفاتيح HMAC مستقلة تمامًا عن بعضها — كل واحد لغرض مختلف (لا يُعاد
# استخدام أيٍّ منها للآخر). القيم أدناه مطابقة عمدًا لنفس default القيم
# التطويرية المضمَّنة في الكود (packages/shared/src/auth-secrets.ts)
# حتى لو نُسِخ هذا الملف حرفيًا إلى بيئة حقيقية بالخطأ — التطبيق يرفض
# الإقلاع في NODE_ENV=production طالما القيمة الفعلية تطابق هذا الافتراضي.
# في أي بيئة حقيقية (NODE_ENV=production): يرفض التطبيق الإقلاع إن كان
# أيٌّ منها مفقودًا/فارغًا/whitespace فقط/القيمة الافتراضية أدناه/أقصر
# من 32 بايت UTF-8/مطابقًا لأحد المتغيرين الآخرين — اضبط ثلاث قيم
# عشوائية حقيقية مختلفة تمامًا عن بعضها (32+ بايت لكل واحدة) عبر
# secret manager خارج GitHub تمامًا — لا تُبقِ القيم أدناه كما هي أبدًا.
AUTH_RATE_LIMIT_HMAC_KEY=dev-only-rate-limit-hmac-key-change-me
AUTH_CREDENTIAL_LOOKUP_HMAC_KEY=dev-only-credential-lookup-hmac-key-change-me
AUTH_RESET_TOKEN_HMAC_KEY=dev-only-reset-token-hmac-key-change-me

# ---- Object storage (MinIO محلي، متوافق مع S3) ----
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=alzad-dev
OBJECT_STORAGE_SECRET_KEY=change-me-dev-only
OBJECT_STORAGE_BUCKET=alzad-platform-dev
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# ---- Web ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
