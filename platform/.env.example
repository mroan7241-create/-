# مثال بيئة تطوير محلي فقط — لا قيم حقيقية هنا. انسخه إلى .env ولا تدفعه لِGit.

# ---- API ----
NODE_ENV=development
API_PORT=3001
API_BASE_PATH=/api/v1
CORRELATION_HEADER=x-correlation-id

# ---- PostgreSQL (packages/db) ----
POSTGRES_USER=alzad_dev
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=alzad_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://alzad_dev:change-me-dev-only@localhost:5432/alzad_platform?schema=public

# ---- Auth (dev secrets only — لا تُستخدم في أي بيئة حقيقية) ----
SESSION_TOKEN_PEPPER=dev-only-pepper-change-me
PASSWORD_HASH_SALT_ROUNDS=12

# ---- Object storage (MinIO محلي، متوافق مع S3) ----
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=alzad-dev
OBJECT_STORAGE_SECRET_KEY=change-me-dev-only
OBJECT_STORAGE_BUCKET=alzad-platform-dev
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# ---- Web ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
