// ============================================================
// 1) accounts
// ============================================================
model Account {
  id                String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  publicCode        String        @unique @map("public_code")
  name              String
  email             String?
  /// NODE-6: رقم جوال المندوب (Delegates.gs — عمود "الهاتف"). عمود عام على
  /// Account لا على جدول منفصل لأنه نفس الكيان الذي يحمل بالفعل ADMIN/
  /// ASSOCIATION بلا جوال (nullable لهما). إضافة بحتة اختيارية — لا NOT NULL
  /// على جدول يحمل صفوفًا فعلًا.
  phone             String?
  role              AccountRole
  associationId     String?       @map("association_id") @db.Uuid
  status            AccountStatus @default(ACTIVE)
  mustChangePassword Boolean      @default(false) @map("must_change_password")
  /// NODE-1: يطابق "آخر دخول" في ورقتي "المستخدمون"/"المناديب" القديمتين — يُحدَّث بعد كل login ناجح فقط.
  lastLoginAt       DateTime?     @map("last_login_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  archivedAt        DateTime?     @map("archived_at")

  association       Association?  @relation(fields: [associationId], references: [id])
  credentials       AuthCredential[]
  sessions          AuthSession[]
  passwordResetTokens PasswordResetToken[]
  reviewedApplications AssociationApplication[] @relation("ApplicationReviewedBy")
  reviewedBeneficiaries Beneficiary[] @relation("BeneficiaryReviewedBy")
  reviewedNeeds     BeneficiaryNeed[] @relation("NeedReviewedBy")
  uploadedFiles     FileObject[]
  createdReceiptBatches ReceiptBatch[] @relation("ReceiptBatchCreatedBy")
  confirmedReceiptBatches ReceiptBatch[] @relation("ReceiptBatchConfirmedBy")
  deviceAllocationsCreated DeviceAllocation[] @relation("AllocationCreatedBy")
  deviceMovementsPerformed DeviceMovement[] @relation("MovementPerformedBy")
  deliveryMissionsAsDelegate DeliveryMission[] @relation("MissionDelegate")
  deliveryAttemptsAsDelegate DeliveryAttempt[] @relation("AttemptDelegate")
  eligibilityReviews AssociationApplication[] @relation("ApplicationEligibilityReviewer")
  selectionApprovals AssociationApplication[] @relation("ApplicationSelectionApprover")
  evaluatedApplications AssociationApplication[] @relation("ApplicationEvaluator")
  participationSetupCompletions ProjectParticipation[] @relation("ParticipationSetupCompletedBy")
  agreementsCreated ParticipationAgreement[] @relation("AgreementCreatedBy")
  coordinatorChangesRequested CoordinatorChangeRequest[] @relation("CoordinatorChangeRequestedBy")
  coordinatorChangesDecided CoordinatorChangeRequest[] @relation("CoordinatorChangeDecidedBy")
  beneficiaryListApprovals Beneficiary[] @relation("BeneficiaryListApprovedBy")
  beneficiaryReplacements BeneficiaryReplacement[] @relation("ReplacementAuthorizedBy")
  deliveryApprovals DeliveryApproval[]
  escalationsCreated EscalationCase[] @relation("EscalationCreatedBy")
  escalationsDecided EscalationCase[] @relation("EscalationDecidedBy")
  purchaseOrdersCreated PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  purchaseOrdersApproved PurchaseOrder[] @relation("PurchaseOrderApprovedBy")
  damageCasesClosed DamageCase[] @relation("DamageCaseClosedBy")
  reconciliationIssuesDecided ShipmentReconciliationIssue[] @relation("ReconciliationIssueDecidedBy")
  notifications Notification[]
  organizationReportsGenerated OrganizationClosureReport[] @relation("OrganizationReportGeneratedBy")
  organizationReportsSubmitted OrganizationClosureReport[] @relation("OrganizationReportSubmittedBy")
  organizationReportsReviewed OrganizationClosureReport[] @relation("OrganizationReportReviewedBy")
  organizationReportsClosed OrganizationClosureReport[] @relation("OrganizationReportClosedBy")
  organizationReportsReopened OrganizationClosureReport[] @relation("OrganizationReportReopenedBy")
  projectReportsActors ProjectClosureReport[] @relation("ProjectReportLastActor")
  auditLogs         AuditLog[]
  idempotencyKeys   IdempotencyKey[]

  /// NODE-2: partial unique index حقيقي (raw SQL في migration.sql) يمنع
  /// أكثر من حساب ASSOCIATION تشغيلي واحد غير مؤرشَف لنفس association_id —
  /// `ux_accounts_one_association_role ON (association_id) WHERE role='ASSOCIATION' AND archived_at IS NULL`.
  @@index([email, status])
  @@map("accounts")
}

// ============================================================
// 2) auth_credentials
// ============================================================
model AuthCredential {
  id                 String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId          String             @map("account_id") @db.Uuid
  type               AuthCredentialType
  identifier         String
  secretHash         String             @map("secret_hash")
  previousSecretHash String?            @map("previous_secret_hash")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  account            Account            @relation(fields: [accountId], references: [id])

  @@unique([type, identifier])
  @@index([accountId])
  @@map("auth_credentials")
}

// ============================================================
// 3) auth_sessions
// ============================================================
model AuthSession {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  /// Sliding expiry (idle TTL) — Legacy APP.sessionSeconds = 21600 (6h). يُمدَّد عند كل طلب موثَّق، بحد أقصى absoluteExpiresAt.
  expiresAt  DateTime  @map("expires_at")
  /// سقف مطلق ثابت منذ إنشاء الجلسة — Legacy APP.maxSessionSeconds = 43200 (12h). لا يُمدَّد أبدًا.
  absoluteExpiresAt DateTime @map("absolute_expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")

  account    Account   @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@map("auth_sessions")
}

// ============================================================
// 4) associations
// ============================================================
model Association {
  id           String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  publicCode   String            @unique @map("public_code")
  name         String
  category     String
  region       String
  city         String
  phones       String[]
  email        String?
  status       AssociationStatus @default(ACTIVE)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  archivedAt   DateTime?         @map("archived_at")

  accounts             Account[]
  beneficiaries        Beneficiary[]
  beneficiaryNeeds     BeneficiaryNeed[]
  receiptBatches       ReceiptBatch[]
  deviceUnits          DeviceUnit[]
  deviceAllocations    DeviceAllocation[]
  deviceMovements      DeviceMovement[]
  deliveryMissions     DeliveryMission[]
  resultingApplication AssociationApplication[] @relation("ApplicationResultingAssociation")
  auditLogs            AuditLog[]
  participation        ProjectParticipation?
  beneficiaryReplacements BeneficiaryReplacement[]
  escalationCases      EscalationCase[]
  purchaseOrders       PurchaseOrder[]
  shipments            Shipment[]
  damageCases          DamageCase[]
  reconciliationIssues ShipmentReconciliationIssue[]
  notifications        Notification[]

  @@index([status])
  @@map("associations")
}

// ============================================================
// 5) association_applications
// ============================================================
model AssociationApplication {
  id                     String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  publicCode             String            @unique @map("public_code")
  clientRequestId        String?           @unique @map("client_request_id")
  name                   String
  /// NODE-2: "التصنيف" (ASSOCIATION_CATEGORY) — اختياري في Legacy فعليًا
  /// (submitAssociationApplication_ لا يفرضه)؛ كان NOT NULL خطأً منذ NODE-0.
  category               String?
  /// NODE-2: "مجال عمل الجمعية" (ASSOCIATION_SECTOR) — nullable على مستوى DB
  /// لاستيعاب صفوف مستوردة تاريخيًا (NODE-8) قد تسبق وجود هذا الحقل في
  /// النموذج القديم؛ الـService الجديدة تفرضه إلزاميًا لكل submission جديد.
  sector                 String?
  region                 String
  city                   String
  phone                  String
  email                  String?
  contactName            String            @map("contact_name")
  notes                  String?
  licenseNumber          String?           @map("license_number")
  licenseExpiryDate      DateTime?         @map("license_expiry_date") @db.Date
  /// NODE-2: FK فريد (@unique) — ملف الترخيص التشغيلي لا يُشارَك بين أكثر من طلب.
  licenseFileId          String?           @unique @map("license_file_id") @db.Uuid
  pledgeAccepted         Boolean           @default(false) @map("pledge_accepted")
  pledgeAcceptedAt       DateTime?         @map("pledge_accepted_at")
  status                 ApplicationStatus @default(UNDER_REVIEW)
  rejectReason           String?           @map("reject_reason")
  /// NODE-2: FK فريد — لا يمكن أن ينتج نفس Association من طلبين مختلفين
  /// (Postgres تعامل NULL كقيم متمايزة في UNIQUE عادي، فلا يمنع تعدد
  /// الطلبات غير المقبولة بعد، وهو السلوك الصحيح المطلوب).
  resultingAssociationId String?           @unique @map("resulting_association_id") @db.Uuid
  submittedAt            DateTime          @default(now()) @map("submitted_at")
  reviewedAt             DateTime?         @map("reviewed_at")
  reviewedById           String?           @map("reviewed_by") @db.Uuid
  address                String?
  serviceScope           String?           @map("service_scope")
  coordinatorPhone       String?           @map("coordinator_phone")
  coordinatorEmail       String?           @map("coordinator_email")
  coordinatorTitle       String?           @map("coordinator_title")
  beneficiaryDatabaseUpdatedAt DateTime?   @map("beneficiary_database_updated_at")
  approxBeneficiaryCount Int?              @map("approx_beneficiary_count")
  approxNeedCount        Int?              @map("approx_need_count")
  initialBeneficiaryFileId String?          @unique @map("initial_beneficiary_file_id") @db.Uuid
  eligibilityStatus      EligibilityStatus @default(PENDING) @map("eligibility_status")
  eligibilityReviewedAt  DateTime?          @map("eligibility_reviewed_at")
  eligibilityReviewedById String?           @map("eligibility_reviewed_by") @db.Uuid
  eligibilityNotes       String?            @map("eligibility_notes")
  evaluationBreakdown    Json?              @map("evaluation_breakdown")
  evaluationScore        Decimal?           @map("evaluation_score") @db.Decimal(5, 2)
  evaluationRank         Int?               @map("evaluation_rank")
  evaluatedAt            DateTime?          @map("evaluated_at")
  evaluatedById          String?            @map("evaluated_by") @db.Uuid
  geographicNeedScore    Decimal?           @map("geographic_need_score") @db.Decimal(5, 2)
  selectionList          AssociationSelectionList @default(NONE) @map("selection_list")
  selectionReason        String?            @map("selection_reason")
  selectionApprovedAt    DateTime?          @map("selection_approved_at")
  selectionApprovedById  String?            @map("selection_approved_by") @db.Uuid
  supporterApprovedAt    DateTime?          @map("supporter_approved_at")
  supporterApprovalReference String?        @map("supporter_approval_reference")

  licenseFile             FileObject?  @relation(fields: [licenseFileId], references: [id])
  initialBeneficiaryFile  FileObject?  @relation("ApplicationInitialBeneficiaryFile", fields: [initialBeneficiaryFileId], references: [id])
  resultingAssociation    Association? @relation("ApplicationResultingAssociation", fields: [resultingAssociationId], references: [id])
  reviewedBy               Account?    @relation("ApplicationReviewedBy", fields: [reviewedById], references: [id])
  eligibilityReviewedBy    Account?    @relation("ApplicationEligibilityReviewer", fields: [eligibilityReviewedById], references: [id])
  selectionApprovedBy      Account?    @relation("ApplicationSelectionApprover", fields: [selectionApprovedById], references: [id])
  evaluatedBy              Account?    @relation("ApplicationEvaluator", fields: [evaluatedById], references: [id])
  answers                  ApplicationAnswer[]
  participation            ProjectParticipation?

  /// NODE-2: partial unique indexes حقيقية (raw SQL في migration.sql —
  /// Prisma @@unique العادي لا يدعم شرط WHERE) تمنع أكثر من طلب
  /// UNDER_REVIEW واحد لنفس البريد/الهاتف/رقم الترخيص المطبَّع؛ سجلات
  /// ACCEPTED/REJECTED التاريخية لا تُحتسَب. راجع ASSOCIATION_APPLICATIONS.md.
  @@index([status])
  @@index([email])
  @@index([phone])
  @@index([licenseNumber])
  @@map("association_applications")
}

// ============================================================
// 6) application_answers
// ============================================================
/// أسئلة القبول الثمانية (Config.gs APPLICATION_QUESTIONS) — صف لكل سؤال بدل أعمدة ثابتة، حتى تُضاف/تُعدَّل الأسئلة مستقبلًا دون migration بنيوية.
model ApplicationAnswer {
  id            String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  applicationId String                  @map("application_id") @db.Uuid
  questionKey   String                  @map("question_key")
  answer        Boolean

  application   AssociationApplication  @relation(fields: [applicationId], references: [id])

  @@unique([applicationId, questionKey])
  @@map("application_answers")
}

// ============================================================
// 7) reference_values
// ============================================================
model ReferenceValue {
  id       String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type     ReferenceValueType
  value    String
  parentId String?             @map("parent_id") @db.Uuid
  sortOrder Int                @default(0) @map("sort_order")
  active   Boolean             @default(true)

  parent   ReferenceValue?     @relation("ReferenceValueHierarchy", fields: [parentId], references: [id])
  children ReferenceValue[]    @relation("ReferenceValueHierarchy")

  /// NODE-0.1: القيد البسيط `@@unique([type, value, parentId])` كان غير
  /// كافٍ — PostgreSQL يعتبر كل NULL مختلفًا عن غيره في UNIQUE عادي، فلا
  /// يمنع تكرار جذور (parentId IS NULL) بنفس (type, value). استُبدل
  /// بـpartial unique indexes حقيقية في migration.sql:
  ///   ux_reference_values_root  ON (type, value) WHERE parent_id IS NULL
  ///   ux_reference_values_child ON (type, value, parent_id) WHERE parent_id IS NOT NULL
  @@index([type, active, sortOrder])
  @@map("reference_values")
}

// ============================================================
// 8) beneficiaries
// ============================================================
model Beneficiary {
  id                     String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  publicCode             String                  @unique @map("public_code")
  associationId          String                  @map("association_id") @db.Uuid
  name                   String
  region                 String
  city                   String
  district               String?
  /// NODE-3: العنوان الوصفي (الشارع وأقرب معلم) — عمود "العنوان" في ورقة
  /// "المستفيدون" القديمة، إلزامي في buildBeneficiaryFieldValues_ (حد 250).
  /// DEFAULT '' على مستوى القاعدة لأن الـmigration إضافية بحتة (append-only)
  /// ولا يجوز أن تفشل على جدول يحمل صفوفًا؛ الإلزام مفروض في طبقة الخدمة
  /// عبر requiredText مطابقةً لِLegacy.
  address                String                  @default("")
  phone                  String
  secondaryPhone         String?                 @map("secondary_phone")
  familyCount            Int                     @map("family_count")
  socialSecurity         Boolean                 @default(false) @map("social_security")
  maritalStatus          String                  @map("marital_status")
  income                 Decimal?                @db.Decimal(12, 2)
  /// NODE-3: "علامة مميزة" (حد 200) و"الملاحظات" (حد 1000) — اختياريان في
  /// Legacy (cleanText_ بلا requiredText_)، فيبقيان nullable هنا.
  landmark               String?
  notes                  String?
  latitude               Decimal?                @db.Decimal(9, 6)
  longitude              Decimal?                @db.Decimal(9, 6)
  locationSource         LocationSource?         @map("location_source")
  locationUpdatedAt      DateTime?               @map("location_updated_at")

  reviewStatus           BeneficiaryReviewStatus @default(UNDER_REVIEW) @map("review_status")
  beneficiaryRejectReason String?                @map("beneficiary_reject_reason")
  reviewedById            String?                @map("reviewed_by") @db.Uuid
  reviewedAt              DateTime?              @map("reviewed_at")
  listType                BeneficiaryListType?    @map("list_type")
  listRank                Int?                    @map("list_rank")
  listReason              String?                 @map("list_reason")
  listApprovedAt          DateTime?               @map("list_approved_at")
  listApprovedById        String?                 @map("list_approved_by") @db.Uuid

  /// الحقل القديم "حالة المستفيد" (Config.gs BENEFICIARY_STATUSES) — يُحفظ للقراءة التاريخية فقط أثناء الهجرة، ليس Source of Truth جديدًا (انظر platform/docs/STATE_MAPPING.md).
  legacyStatus            LegacyBeneficiaryStatus? @map("legacy_status")
  /// نص "الاحتياج" الحر القديم قبل beneficiary_needs — يُحفظ للأرشفة فقط.
  legacyNeedsText          String?                @map("legacy_needs_text")

  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")
  archivedAt                DateTime?            @map("archived_at")

  association              Association           @relation(fields: [associationId], references: [id])
  reviewedBy                Account?             @relation("BeneficiaryReviewedBy", fields: [reviewedById], references: [id])
  listApprovedBy            Account?             @relation("BeneficiaryListApprovedBy", fields: [listApprovedById], references: [id])
  needs                      BeneficiaryNeed[]
  deviceAllocations          DeviceAllocation[]
  deliveryMissions            DeliveryMission[]
  deliveryAttempts             DeliveryAttempt[]
  replacementsAsOld            BeneficiaryReplacement[] @relation("ReplacementOldBeneficiary")
  replacementsAsNew            BeneficiaryReplacement[] @relation("ReplacementNewBeneficiary")
  escalationCases              EscalationCase[]

  /// NODE-0.1: مفتاح فريد مركَّب (id, associationId) — يسمح لكيانات تابعة
  /// (BeneficiaryNeed, DeviceAllocation, DeliveryMission...) بالإشارة إلى
  /// هذا المستفيد عبر composite foreign key يفرض تطابق association_id
  /// حقيقيًا على مستوى قاعدة البيانات، لا فقط عبر Service validation.
  @@unique([id, associationId])
  @@index([associationId, reviewStatus])
  @@index([phone])
  @@map("beneficiaries")
}

// ============================================================
// 9) beneficiary_needs
// ============================================================
model BeneficiaryNeed {
  id                String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  publicCode        String                 @unique @map("public_code")
  beneficiaryId     String                 @map("beneficiary_id") @db.Uuid
  associationId     String                 @map("association_id") @db.Uuid
  deviceType        DeviceType             @map("device_type")

  decisionStatus    NeedDecisionStatus     @default(PENDING) @map("decision_status")
  rejectReason      String?                @map("reject_reason")
  reviewedById      String?                @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime?              @map("reviewed_at")

  fulfillmentStatus NeedFulfillmentStatus? @map("fulfillment_status")

  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  /// NODE-0.1: composite FK (beneficiaryId, associationId) → beneficiaries(id, associationId)
  /// يمنع DB-level أن يشير احتياج جمعية A إلى مستفيد جمعية B — لا يكفي
  /// وجود association_id على الصف نفسه، بل يجب أن يطابق association_id
  /// الفعلي للمستفيد المُشار إليه، وإلا رفض PostgreSQL الإدراج/التحديث.
  beneficiary       Beneficiary            @relation(fields: [beneficiaryId, associationId], references: [id, associationId])
  association       Association            @relation(fields: [associationId], references: [id])
  reviewedBy        Account?               @relation("NeedReviewedBy", fields: [reviewedById], references: [id])
  allocations       DeviceAllocation[]

  /// NODE-0.1: composite unique إضافي — يتيح composite FK من
  /// device_allocations إليه (device_allocations.beneficiary_need_id +
  /// association_id → beneficiary_needs.id + association_id).
  @@unique([id, associationId])
  /// القيد الحالي: مستفيد واحد لا يملك أكثر من احتياج واحد من نفس device_type.
  ///
  /// NODE-3 — تحقُّق مصدري: هذا القيد **الكامل** (لا فهرس جزئي مشروط بحالة
  /// القرار) هو المطابق حرفيًا لِLegacy. في `BeneficiaryNeeds.gs` كل فحوص
  /// التكرار تبني `existingByType` من **كل** صفوف احتياج المستفيد بلا أي
  /// تصفية على "حالة القرار" (`setBeneficiaryNeeds_` سطر 122-125،
  /// `updateBeneficiaryWithNeeds_` سطر 431-433) — أي أن احتياجًا **مرفوضًا**
  /// من نفس النوع يمنع إعادة تسجيل نفس النوع تمامًا كالمعلَّق والمعتمد.
  /// لذلك لا فهرس جزئي هنا: فهرس جزئي على PENDING/APPROVED فقط كان سيسمح
  /// بإعادة تقديم نوع سبق رفضه، وهو سلوك **لا** يوجد في النظام القديم.
  @@unique([beneficiaryId, deviceType])
  @@index([beneficiaryId])
  @@index([associationId, decisionStatus, fulfillmentStatus])
  @@map("beneficiary_needs")
}

// ============================================================
