// ============================================================
// 21) audit_logs (append-only)
// ============================================================
model AuditLog {
  id              String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorAccountId  String?      @map("actor_account_id") @db.Uuid
  actorRole       AccountRole? @map("actor_role")
  associationId   String?      @map("association_id") @db.Uuid

