// ============================================================
// منصة جمعية الزاد — Prisma schema (NODE-0 + NODE-0.1 Hardening)
// ============================================================
// هذا الملف هو Source of Truth الوحيد لبنية قاعدة البيانات. أي تعديل
// على البنية يمر عبر migration جديدة هنا — ممنوع أي تعديل يدوي مباشر
// على قاعدة البيانات (انظر platform/docs/ARCHITECTURE.md، قسم "قواعد
// حاكمة").
//
// قرار معماري: Domain Model علائقي حقيقي، وليس نسخة حرفية من أوراق
// Google Sheets القديمة. كل كيان يحمل Internal PK من نوع UUID
// (uuidv7()) — ترتيب زمني قابل للفرز خلافًا لـuuid v4 العشوائي — وحقل
// publicCode منفصل تمامًا يحمل الرقم البشري القديم (BEN-000001 ...)
// للعرض وربط بيانات الهجرة القديمة فقط — لا يُستخدم أبدًا كـForeign Key.
//
// ملاحظة uuidv7() (NODE-0.1): PostgreSQL 18 يوفّرها كدالة مدمجة في
// pg_catalog. لضمان التوافق مع أي نسخة PostgreSQL أقدم (بيئات تطوير/CI
// قد لا تشغّل 18 بعد)، تُنشئ الـmigration الأولى أيضًا دالة توافقية
// public.uuidv7() (polyfill قياسي عبر gen_random_uuid() + overlay
// الطابع الزمني). على PostgreSQL 18 الدالة المدمجة في pg_catalog تُستدعى
// أولًا تلقائيًا (search_path يضع pg_catalog قبل public ضمنيًا) فتُشِلّ
// النسخة التوافقية بصمت (لا تعارض تسمية — مخطَّطان مختلفان)، وعلى أي
// نسخة أقدم تُستخدم النسخة التوافقية. راجع migration.sql للتفاصيل.
//
// النطاق: NODE-0 صمّم كل الكيانات المطلوبة لموازاة الميزات الحالية.
// NODE-0.1 (هذه المراجعة) تُقوّي القيود البنيوية (Source of Truth
// وحيد للتخصيص، عزل tenant حقيقي بقيود DB، صحة enum لنوع الجهاز، صحة
// موقع الجهاز) — لا يزال بلا أي منطق أعمال مُطبَّق (راجع
// platform/docs/FEATURE_PARITY.md).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums (تطابق حرفيًا packages/shared/src/enums.ts)
// ============================================================

enum AccountRole {
  ADMIN
  ASSOCIATION
  DELEGATE
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum AuthCredentialType {
  EMAIL_PASSWORD
  DELEGATE_ACCESS_CODE
}

enum AssociationStatus {
  ACTIVE
  INACTIVE
}

enum ApplicationStatus {
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

enum BeneficiaryReviewStatus {
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum LegacyBeneficiaryStatus {
  NEW
  UNDER_REVIEW
  APPROVED
  AWAITING_DEVICES
  DELIVERY_IN_PROGRESS
  DELIVERED
  CANCELLED
}

enum NeedDecisionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NeedFulfillmentStatus {
  APPROVED_ENTITLEMENT
  AWAITING_DEVICE
  DEVICE_READY
  AWAITING_DELEGATE_ASSIGNMENT
  ASSIGNED_TO_DELEGATE_PENDING
  OUT_WITH_DELEGATE
  DEFERRED
  AWAITING_RETURN_CONFIRMATION
  RETURNED_TO_ASSOCIATION_WAREHOUSE
  DELIVERED
}

/// وحّدت (NODE-0.1) لتكون enum داخلي واحد ثابت مستخدَم حرفيًا عبر ثلاثة
/// كيانات معًا: BeneficiaryNeed.deviceType (إلزامي)، وReceiptItem.deviceType
/// وDeviceUnit.deviceType (اختياري + legacyDeviceTypeText — راجع تعليق كل
/// حقل). لا نص حر لأي سجل تشغيلي جديد.
enum DeviceType {
  REFRIGERATOR
  OVEN
  WASHING_MACHINE
}

enum DeviceStatus {
  WAREHOUSE
  ALLOCATED
  WITH_DELEGATE
  DELIVERED
  DAMAGED
}

enum DeliveryStatus {
  NOT_STARTED
  PREPARING
  OUT_WITH_DELEGATE
  DELIVERED
  DELIVERY_FAILED
}

enum DeliveryFailureReason {
  COULD_NOT_REACH
  NO_ANSWER
  POSTPONEMENT_REQUESTED
  INCORRECT_ADDRESS
  NOT_FOUND
  RECEIPT_REFUSED
}

enum ReceiptBatchStatus {
  DRAFT
  AWAITING_ASSOCIATION_CONFIRMATION
  RECEIVED_COMPLETE
  RECEIVED_WITH_DISCREPANCIES
}

enum LocationSource {
  MAP
  CURRENT_LOCATION
  IMPORT
  MANUAL
}

/// NODE-1: توسيع لمطابقة REFERENCE_DATA_TYPES_ الفعلية في ReferenceData.gs
/// (10 أنواع بالضبط) — كانت 5 فقط في NODE-0 (ناقصة عمدًا حينها، صُححت هنا).
enum ReferenceValueType {
  REGION
  CITY
  ASSOCIATION_CATEGORY
  SOCIAL_STATUS
  DEVICE_TYPE
  ASSOCIATION_SECTOR
  DEVICE_SPEC
  SUPPLIER
  DIFFERENCE_REASON
  RECEIVER_TITLE
}

enum FileCategory {
  ASSOCIATION_LICENSE
  RECEIPT_QUANTITY_PHOTO
  RECEIPT_SIGNATURE_PHOTO
  RECEIPT_DAMAGE_PHOTO
  DELIVERY_PROOF_PHOTO
  DELIVERY_RECIPIENT_SIGNATURE
  ACTIVITY_EVIDENCE
}

enum DeviceAllocationStatus {
  ACTIVE
  RELEASED
}

enum IdempotencyKeyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum OutboxEventType {
  BENEFICIARY_APPROVED
  RECEIPT_CONFIRMED
  STOCK_INCREASED
}

enum OutboxEventStatus {
  PENDING
  PROCESSED
  FAILED
}

enum DeviceMovementLocationType {
  WAREHOUSE
  DELEGATE
  BENEFICIARY
  DAMAGED_HOLDING
}

// ============================================================
// 1) accounts
// ============================================================
model Account {
  id                String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  publicCode        String        @unique @map("public_code")
  name              String
  email             String?
  role              AccountRole
  associationId     String?       @map("association_id") @db.Uuid
  status            AccountStatus @default(ACTIVE)
  mustChangePassword Boolean      @default(false) @map("must_change_password")
  /// NODE-1: يطابق "آخر دخول" في ورقتي "المستخدمون"/"المناديب" القديمتين — يُحدَّث بعد كل login ناجح فقط.
  lastLoginAt       DateTime?     @map("last_login_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  archivedAt        DateTime?     @map("archived_at")

  association       Association?  @relation(fields: [associationId], references: [id])
  credentials       AuthCredential[]
  sessions          AuthSession[]
  passwordResetTokens PasswordResetToken[]
  reviewedApplications AssociationApplication[] @relation("ApplicationReviewedBy")
  reviewedBeneficiaries Beneficiary[] @relation("BeneficiaryReviewedBy")
  reviewedNeeds     BeneficiaryNeed[] @relation("NeedReviewedBy")
  uploadedFiles     FileObject[]
  createdReceiptBatches ReceiptBatch[] @relation("ReceiptBatchCreatedBy")
  confirmedReceiptBatches ReceiptBatch[] @relation("ReceiptBatchConfirmedBy")
  deviceAllocationsCreated DeviceAllocation[] @relation("AllocationCreatedBy")
  deviceMovementsPerformed DeviceMovement[] @relation("MovementPerformedBy")
  deliveryMissionsAsDelegate DeliveryMission[] @relation("MissionDelegate")
  deliveryAttemptsAsDelegate DeliveryAttempt[] @relation("AttemptDelegate")
  auditLogs         AuditLog[]
  idempotencyKeys   IdempotencyKey[]

  /// NODE-2: partial unique index حقيقي (raw SQL في migration.sql) يمنع
  /// أكثر من حساب ASSOCIATION تشغيلي واحد غير مؤرشَف لنفس association_id —
  /// `ux_accounts_one_association_role ON (association_id) WHERE role='ASSOCIATION' AND archived_at IS NULL`.
  @@index([email, status])
  @@map("accounts")
}

// ============================================================
// 2) auth_credentials
// ============================================================
model AuthCredential {
  id                 String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId          String             @map("account_id") @db.Uuid
  type               AuthCredentialType
  identifier         String
  secretHash         String             @map("secret_hash")
  previousSecretHash String?            @map("previous_secret_hash")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  account            Account            @relation(fields: [accountId], references: [id])

  @@unique([type, identifier])
  @@index([accountId])
  @@map("auth_credentials")
}

// ============================================================
// 3) auth_sessions
// ============================================================
model AuthSession {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  /// Sliding expiry (idle TTL) — Legacy APP.sessionSeconds = 21600 (6h). يُمدَّد عند كل طلب موثَّق، بحد أقصى absoluteExpiresAt.
  expiresAt  DateTime  @map("expires_at")
  /// سقف مطلق ثابت منذ إنشاء الجلسة — Legacy APP.maxSessionSeconds = 43200 (12h). لا يُمدَّد أبدًا.
  absoluteExpiresAt DateTime @map("absolute_expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")

  account    Account   @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@map("auth_sessions")
}

// ============================================================
// 4) associations
// ============================================================
model Association {
  id           String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  publicCode   String            @unique @map("public_code")
  name         String
  category     String
  region       String
  city         String
  phones       String[]
  email        String?
  status       AssociationStatus @default(ACTIVE)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  archivedAt   DateTime?         @map("archived_at")

  accounts             Account[]
  beneficiaries        Beneficiary[]
  beneficiaryNeeds     BeneficiaryNeed[]
  receiptBatches       ReceiptBatch[]
  deviceUnits          DeviceUnit[]
  deviceAllocations    DeviceAllocation[]
  deviceMovements      DeviceMovement[]
  deliveryMissions     DeliveryMission[]
  resultingApplication AssociationApplication[] @relation("ApplicationResultingAssociation")
  auditLogs            AuditLog[]

  @@index([status])
  @@map("associations")
}

// ============================================================
// 5) association_applications
// ============================================================
model AssociationApplication {
  id                     String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  publicCode             String            @unique @map("public_code")
  clientRequestId        String?           @unique @map("client_request_id")
  name                   String
  /// NODE-2: "التصنيف" (ASSOCIATION_CATEGORY) — اختياري في Legacy فعليًا
  /// (submitAssociationApplication_ لا يفرضه)؛ كان NOT NULL خطأً منذ NODE-0.
  category               String?
  /// NODE-2: "مجال عمل الجمعية" (ASSOCIATION_SECTOR) — nullable على مستوى DB
  /// لاستيعاب صفوف مستوردة تاريخيًا (NODE-8) قد تسبق وجود هذا الحقل في
  /// النموذج القديم؛ الـService الجديدة تفرضه إلزاميًا لكل submission جديد.
  sector                 String?
  region                 String
  city                   String
  phone                  String
  email                  String?
  contactName            String            @map("contact_name")
  notes                  String?
  licenseNumber          String?           @map("license_number")
  licenseExpiryDate      DateTime?         @map("license_expiry_date") @db.Date
  /// NODE-2: FK فريد (@unique) — ملف الترخيص التشغيلي لا يُشارَك بين أكثر من طلب.
  licenseFileId          String?           @unique @map("license_file_id") @db.Uuid
  pledgeAccepted         Boolean           @default(false) @map("pledge_accepted")
  pledgeAcceptedAt       DateTime?         @map("pledge_accepted_at")
  status                 ApplicationStatus @default(UNDER_REVIEW)
  rejectReason           String?           @map("reject_reason")
  /// NODE-2: FK فريد — لا يمكن أن ينتج نفس Association من طلبين مختلفين
  /// (Postgres تعامل NULL كقيم متمايزة في UNIQUE عادي، فلا يمنع تعدد
  /// الطلبات غير المقبولة بعد، وهو السلوك الصحيح المطلوب).
  resultingAssociationId String?           @unique @map("resulting_association_id") @db.Uuid
  submittedAt            DateTime          @default(now()) @map("submitted_at")
  reviewedAt             DateTime?         @map("reviewed_at")
  reviewedById           String?           @map("reviewed_by") @db.Uuid

  licenseFile             FileObject?  @relation(fields: [licenseFileId], references: [id])
  resultingAssociation    Association? @relation("ApplicationResultingAssociation", fields: [resultingAssociationId], references: [id])
  reviewedBy               Account?    @relation("ApplicationReviewedBy", fields: [reviewedById], references: [id])
  answers                  ApplicationAnswer[]

  /// NODE-2: partial unique indexes حقيقية (raw SQL في migration.sql —
  /// Prisma @@unique العادي لا يدعم شرط WHERE) تمنع أكثر من طلب
  /// UNDER_REVIEW واحد لنفس البريد/الهاتف/رقم الترخيص المطبَّع؛ سجلات
  /// ACCEPTED/REJECTED التاريخية لا تُحتسَب. راجع ASSOCIATION_APPLICATIONS.md.
  @@index([status])
  @@index([email])
  @@index([phone])
  @@index([licenseNumber])
  @@map("association_applications")
}

// ============================================================
// 6) application_answers
// ============================================================
/// أسئلة القبول الثمانية (Config.gs APPLICATION_QUESTIONS) — صف لكل سؤال بدل أعمدة ثابتة، حتى تُضاف/تُعدَّل الأسئلة مستقبلًا دون migration بنيوية.
model ApplicationAnswer {
  id            String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  applicationId String                  @map("application_id") @db.Uuid
  questionKey   String                  @map("question_key")
  answer        Boolean

  application   AssociationApplication  @relation(fields: [applicationId], references: [id])

  @@unique([applicationId, questionKey])
  @@map("application_answers")
}

// ============================================================
// 7) reference_values
// ============================================================
model ReferenceValue {
  id       String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type     ReferenceValueType
  value    String
  parentId String?             @map("parent_id") @db.Uuid
  sortOrder Int                @default(0) @map("sort_order")
  active   Boolean             @default(true)

  parent   ReferenceValue?     @relation("ReferenceValueHierarchy", fields: [parentId], references: [id])
  children ReferenceValue[]    @relation("ReferenceValueHierarchy")

  /// NODE-0.1: القيد البسيط `@@unique([type, value, parentId])` كان غير
  /// كافٍ — PostgreSQL يعتبر كل NULL مختلفًا عن غيره في UNIQUE عادي، فلا
  /// يمنع تكرار جذور (parentId IS NULL) بنفس (type, value). استُبدل
  /// بـpartial unique indexes حقيقية في migration.sql:
  ///   ux_reference_values_root  ON (type, value) WHERE parent_id IS NULL
  ///   ux_reference_values_child ON (type, value, parent_id) WHERE parent_id IS NOT NULL
  @@index([type, active, sortOrder])
  @@map("reference_values")
}

// ============================================================
// 8) beneficiaries
// ============================================================
model Beneficiary {
  id                     String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  publicCode             String                  @unique @map("public_code")
  associationId          String                  @map("association_id") @db.Uuid
  name                   String
  region                 String
  city                   String
  district               String?
  phone                  String
  secondaryPhone         String?                 @map("secondary_phone")
  familyCount            Int                     @map("family_count")
  socialSecurity         Boolean                 @default(false) @map("social_security")
  maritalStatus          String                  @map("marital_status")
  income                 Decimal?                @db.Decimal(12, 2)
  latitude               Decimal?                @db.Decimal(9, 6)
  longitude              Decimal?                @db.Decimal(9, 6)
  locationSource         LocationSource?         @map("location_source")
  locationUpdatedAt      DateTime?               @map("location_updated_at")

  reviewStatus           BeneficiaryReviewStatus @default(UNDER_REVIEW) @map("review_status")
  beneficiaryRejectReason String?                @map("beneficiary_reject_reason")
  reviewedById            String?                @map("reviewed_by") @db.Uuid
  reviewedAt              DateTime?              @map("reviewed_at")

  /// الحقل القديم "حالة المستفيد" (Config.gs BENEFICIARY_STATUSES) — يُحفظ للقراءة التاريخية فقط أثناء الهجرة، ليس Source of Truth جديدًا (انظر platform/docs/STATE_MAPPING.md).
  legacyStatus            LegacyBeneficiaryStatus? @map("legacy_status")
  /// نص "الاحتياج" الحر القديم قبل beneficiary_needs — يُحفظ للأرشفة فقط.
  legacyNeedsText          String?                @map("legacy_needs_text")

  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")
  archivedAt                DateTime?            @map("archived_at")

  association              Association           @relation(fields: [associationId], references: [id])
  reviewedBy                Account?             @relation("BeneficiaryReviewedBy", fields: [reviewedById], references: [id])
  needs                      BeneficiaryNeed[]
  deviceAllocations          DeviceAllocation[]
  deliveryMissions            DeliveryMission[]
  deliveryAttempts             DeliveryAttempt[]

  /// NODE-0.1: مفتاح فريد مركَّب (id, associationId) — يسمح لكيانات تابعة
  /// (BeneficiaryNeed, DeviceAllocation, DeliveryMission...) بالإشارة إلى
  /// هذا المستفيد عبر composite foreign key يفرض تطابق association_id
  /// حقيقيًا على مستوى قاعدة البيانات، لا فقط عبر Service validation.
  @@unique([id, associationId])
  @@index([associationId, reviewStatus])
  @@index([phone])
  @@map("beneficiaries")
}

// ============================================================
// 9) beneficiary_needs
// ============================================================
model BeneficiaryNeed {
  id                String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  publicCode        String                 @unique @map("public_code")
  beneficiaryId     String                 @map("beneficiary_id") @db.Uuid
  associationId     String                 @map("association_id") @db.Uuid
  deviceType        DeviceType             @map("device_type")

  decisionStatus    NeedDecisionStatus     @default(PENDING) @map("decision_status")
  rejectReason      String?                @map("reject_reason")
  reviewedById      String?                @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime?              @map("reviewed_at")

  fulfillmentStatus NeedFulfillmentStatus? @map("fulfillment_status")

  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  /// NODE-0.1: composite FK (beneficiaryId, associationId) → beneficiaries(id, associationId)
  /// يمنع DB-level أن يشير احتياج جمعية A إلى مستفيد جمعية B — لا يكفي
  /// وجود association_id على الصف نفسه، بل يجب أن يطابق association_id
  /// الفعلي للمستفيد المُشار إليه، وإلا رفض PostgreSQL الإدراج/التحديث.
  beneficiary       Beneficiary            @relation(fields: [beneficiaryId, associationId], references: [id, associationId])
  association       Association            @relation(fields: [associationId], references: [id])
  reviewedBy        Account?               @relation("NeedReviewedBy", fields: [reviewedById], references: [id])
  allocations       DeviceAllocation[]

  /// NODE-0.1: composite unique إضافي — يتيح composite FK من
  /// device_allocations إليه (device_allocations.beneficiary_need_id +
  /// association_id → beneficiary_needs.id + association_id).
  @@unique([id, associationId])
  /// القيد الحالي: مستفيد واحد لا يملك أكثر من احتياج واحد من نفس device_type.
  @@unique([beneficiaryId, deviceType])
  @@index([beneficiaryId])
  @@index([associationId, decisionStatus, fulfillmentStatus])
  @@map("beneficiary_needs")
}

// ============================================================
// 10) files
// ============================================================
model FileObject {
  id              String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  storageProvider String       @map("storage_provider")
  bucket          String
  objectKey       String       @map("object_key")
  originalName    String       @map("original_name")
  mimeType        String       @map("mime_type")
  sizeBytes       BigInt       @map("size_bytes")
  sha256          String?
  category        FileCategory
  uploadedById    String?      @map("uploaded_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")

  uploadedBy      Account?     @relation(fields: [uploadedById], references: [id])

  associationApplications AssociationApplication[]
  receiptBatchQuantityPhoto ReceiptBatch[] @relation("ReceiptBatchQuantityPhoto")
  receiptBatchSignaturePhoto ReceiptBatch[] @relation("ReceiptBatchSignaturePhoto")
  receiptDamagePhotos ReceiptDamagePhoto[]
  deliveryAttemptProof DeliveryAttempt[] @relation("AttemptProofFile")
  deliveryAttemptSignature DeliveryAttempt[] @relation("AttemptSignatureFile")
  activityEvidence  ActivityEvidence[]

  @@unique([bucket, objectKey])
  @@index([category])
  @@map("files")
}

// ============================================================
// 11) receipt_batches
// ============================================================
model ReceiptBatch {
  id                  String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  publicCode          String             @unique @map("public_code")
  associationId       String             @map("association_id") @db.Uuid
  supplierName        String             @map("supplier_name")
  sentAt              DateTime?          @map("sent_at")
  createdById         String             @map("created_by") @db.Uuid
  status              ReceiptBatchStatus @default(DRAFT)
  notes                String?

  receiverName          String?          @map("receiver_name")
  receiverTitle          String?         @map("receiver_title")

  quantityPhotoFileId     String?        @map("quantity_photo_file_id") @db.Uuid
  signatureFileId          String?       @map("signature_file_id") @db.Uuid

  confirmedAt                DateTime?   @map("confirmed_at")
  /// من يؤكد الاستلام يجب ألا يكون نفس من أنشأ المحضر (نفس قاعدة النظام القديم — تُفرض في خدمة apps/api لاحقًا، لا في القيد البنيوي وحده).
  confirmedById               String?    @map("confirmed_by") @db.Uuid

  createdAt                    DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime @updatedAt @map("updated_at")

  association          Association       @relation(fields: [associationId], references: [id])
  createdBy             Account          @relation("ReceiptBatchCreatedBy", fields: [createdById], references: [id])
  confirmedBy            Account?        @relation("ReceiptBatchConfirmedBy", fields: [confirmedById], references: [id])
  quantityPhotoFile        FileObject?   @relation("ReceiptBatchQuantityPhoto", fields: [quantityPhotoFileId], references: [id])
  signatureFile              FileObject? @relation("ReceiptBatchSignaturePhoto", fields: [signatureFileId], references: [id])
  items                       ReceiptItem[]

  @@index([associationId, status])
  @@map("receipt_batches")
}

// ============================================================
// 12) receipt_items
// ============================================================
model ReceiptItem {
  id               String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  publicCode       String       @unique @map("public_code")
  receiptBatchId   String       @map("receipt_batch_id") @db.Uuid

  /// NODE-0.1: وُحِّد إلى enum DeviceType — اختياري فقط لاستيعاب سجلات
  /// تاريخية مستوردة (NODE-8) بنوع خارج الثلاثة المعتمدة؛ كل بند جديد
  /// يُنشأ من خدمة apps/api (لا استيراد) **يجب** أن يحمل deviceType غير
  /// فارغ — يُفرض ذلك على مستوى Service (DTO validation)، لا عبر NOT
  /// NULL في DB لأن DB نفسها تستضيف كلا الحالتين. راجع CHECK constraint
  /// ck_receipt_items_device_type_present في migration.sql (يفرض على
  /// الأقل حقلًا واحدًا من الاثنين غير فارغ دائمًا).
  deviceType        DeviceType? @map("device_type")
  /// نص تاريخي حر خارج enum الثلاثة — أرشيف هجرة فقط، ليس Source of
  /// Truth لأي سجل تشغيلي جديد (راجع platform/docs/LEGACY_DATA_MIGRATION.md).
  legacyDeviceTypeText String?   @map("legacy_device_type_text")
  spec             String?

  sentQty          Int          @map("sent_qty")
  goodQty          Int          @default(0) @map("good_qty")
  damagedQty       Int          @default(0) @map("damaged_qty")
  missingQty       Int          @default(0) @map("missing_qty")

  differenceReason String?      @map("difference_reason")
  differenceNotes  String?      @map("difference_notes")

  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  receiptBatch     ReceiptBatch @relation(fields: [receiptBatchId], references: [id])
  damagePhotos     ReceiptDamagePhoto[]
  deviceUnits      DeviceUnit[]

  @@index([receiptBatchId])
  @@map("receipt_items")
}

// ============================================================
// 13) receipt_damage_photos
// ============================================================
model ReceiptDamagePhoto {
  id            String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  publicCode    String      @unique @map("public_code")
  receiptItemId String      @map("receipt_item_id") @db.Uuid
  fileId        String      @map("file_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at")

  receiptItem   ReceiptItem @relation(fields: [receiptItemId], references: [id])
  file          FileObject  @relation(fields: [fileId], references: [id])

  @@index([receiptItemId])
  @@map("receipt_damage_photos")
}

// ============================================================
// 14) device_units
// ============================================================
model DeviceUnit {
  id                 String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  publicCode         String        @unique @map("public_code")

  associationId      String        @map("association_id") @db.Uuid
  /// NODE-0.1: نفس مبدأ ReceiptItem.deviceType أعلاه — enum اختياري +
  /// legacyDeviceTypeText للأرشيف التاريخي فقط، إلزامي منطقيًا لأي جهاز
  /// جديد على مستوى Service. راجع ck_device_units_device_type_present.
  deviceType         DeviceType?   @map("device_type")
  legacyDeviceTypeText String?     @map("legacy_device_type_text")
  spec               String?
  receiptItemId      String?       @map("receipt_item_id") @db.Uuid

  status             DeviceStatus  @default(WAREHOUSE)

  /// NODE-0.1 — القاعدة الحاكمة: "لا يوجد جهاز بموقع مجهول". Invariant
  /// موثَّق ومفروض جزئيًا عبر CHECK constraint (ck_device_units_location_ref_by_type
  /// في migration.sql):
  ///   WAREHOUSE / DAMAGED_HOLDING → currentLocationRef يجب أن يكون NULL
  ///     (الموقع معروف بالفعل عبر association_id على هذا السجل نفسه —
  ///     لا كيان "مستودع"/"حجز تلف" مستقل بعد في NODE-0.1؛ لا Custody
  ///     workflow جديدة تُبنى هنا)
  ///   DELEGATE / BENEFICIARY → currentLocationRef إلزامي (NOT NULL)
  /// ما لا تفرضه DB (polymorphic FK غير ممكن بعمود واحد يشير لجدولين
  /// مختلفين حسب النوع): أن currentLocationRef يشير فعليًا لصف موجود في
  /// accounts (دور DELEGATE) أو beneficiaries حسب النوع، وأن ذلك الحساب/
  /// المستفيد ينتمي لنفس associationId. هذا يبقى Service-level validation
  /// صريحًا يُطبَّق عند تفعيل InventoryModule/DeliveriesModule فعليًا
  /// (NODE-4/NODE-6) — موثَّق أيضًا في platform/docs/ARCHITECTURE.md.
  currentLocationType DeviceMovementLocationType @map("current_location_type")
  currentLocationRef  String?      @map("current_location_ref") @db.Uuid

  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  deliveredAt         DateTime?    @map("delivered_at")

  association         Association  @relation(fields: [associationId], references: [id])
  receiptItem          ReceiptItem? @relation(fields: [receiptItemId], references: [id])
  allocations           DeviceAllocation[]
  movements              DeviceMovement[]

  /// NODE-0.1 (القسم 1): أُزيل الربط المباشر deviceUnit → beneficiaryNeed
  /// (beneficiaryNeedId/beneficiaryNeed) الذي كان موجودًا في NODE-0 —
  /// كان يمثّل مصدر حقيقة مزدوجًا للتخصيص إلى جانب DeviceAllocation. الآن
  /// DeviceAllocation (بحقلها status=ACTIVE الفريد جزئيًا لكل device)
  /// هي المصدر الوحيد لمعرفة أي احتياج/مستفيد مخصَّص له هذا الجهاز
  /// حاليًا؛ لا beneficiaryId مباشر أيضًا على DeviceUnit لنفس السبب. حالة
  /// الجهاز (status) + وجود DeviceAllocation نشطة هي ما يحدِّد التخصيص.
  @@unique([id, associationId])
  @@index([associationId, deviceType, status])
  @@map("device_units")
}

// ============================================================
// 15) device_allocations
// ============================================================
model DeviceAllocation {
  id               String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  deviceId         String                 @map("device_id") @db.Uuid
  beneficiaryNeedId String                @map("beneficiary_need_id") @db.Uuid
  beneficiaryId     String                @map("beneficiary_id") @db.Uuid
  associationId      String               @map("association_id") @db.Uuid

  status             DeviceAllocationStatus @default(ACTIVE)
  allocatedAt         DateTime             @default(now()) @map("allocated_at")
  releasedAt            DateTime?          @map("released_at")
  releaseReason           String?          @map("release_reason")

  createdById               String?        @map("created_by") @db.Uuid
  source                     String?        /// اسم العملية المصدر (allocator/manual/rebalance) — للتتبع فقط

  /// NODE-0.1 (القسم 2): composite FKs تفرض أن الجهاز/الاحتياج/المستفيد
  /// الثلاثة المشار إليهم من هذا التخصيص ينتمون فعليًا لنفس associationId
  /// المسجَّل على صف التخصيص نفسه — لا drift ممكن على مستوى DB، لا فقط
  /// Service validation.
  device               DeviceUnit          @relation(fields: [deviceId, associationId], references: [id, associationId])
  beneficiaryNeed        BeneficiaryNeed   @relation(fields: [beneficiaryNeedId, associationId], references: [id, associationId])
  beneficiary              Beneficiary     @relation(fields: [beneficiaryId, associationId], references: [id, associationId])
  association                Association   @relation(fields: [associationId], references: [id])
  createdBy                    Account?    @relation("AllocationCreatedBy", fields: [createdById], references: [id])

  /// "الجهاز يملك تخصيصًا نشطًا واحدًا فقط" و"الاحتياج لا يملك أكثر من جهاز Active" — partial unique indexes حقيقية تُضاف عبر SQL خام في الـmigration (راجع migration.sql: ux_device_allocations_active_device / ux_device_allocations_active_need)، لأن Prisma schema لا يدعم WHERE على @@unique مباشرة.
  @@index([associationId, status])
  @@map("device_allocations")
}

// ============================================================
// 16) device_movements (append-only)
// ============================================================
model DeviceMovement {
  id               String                     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  deviceId         String                     @map("device_id") @db.Uuid
  associationId    String                     @map("association_id") @db.Uuid

  fromLocationType DeviceMovementLocationType? @map("from_location_type")
  fromLocationRef  String?                    @map("from_location_ref") @db.Uuid
  toLocationType   DeviceMovementLocationType @map("to_location_type")
  toLocationRef    String?                    @map("to_location_ref") @db.Uuid

  reason           String
  referenceType    String?                    @map("reference_type")
  referenceId      String?                    @map("reference_id") @db.Uuid

  performedById    String?                    @map("performed_by") @db.Uuid
  createdAt        DateTime                   @default(now()) @map("created_at")

  /// NODE-0.1 (القسم 2): composite FK يمنع تسجيل حركة لجهاز لا ينتمي فعليًا لنفس associationId المسجَّل على صف الحركة.
  device           DeviceUnit                 @relation(fields: [deviceId, associationId], references: [id, associationId])
  association      Association                @relation(fields: [associationId], references: [id])
  performedBy      Account?                   @relation("MovementPerformedBy", fields: [performedById], references: [id])

  @@index([deviceId, createdAt])
  @@map("device_movements")
}

// ============================================================
// 17) delivery_missions
// ============================================================
model DeliveryMission {
  id                String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  publicCode        String          @unique @map("public_code")

  beneficiaryId     String          @map("beneficiary_id") @db.Uuid
  associationId     String          @map("association_id") @db.Uuid
  delegateAccountId String?         @map("delegate_account_id") @db.Uuid

  status            DeliveryStatus  @default(NOT_STARTED)
  assignedAt        DateTime?       @map("assigned_at")
  scheduledFor      DateTime?       @map("scheduled_for")

  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  /// NODE-0.1 (القسم 2): composite FK يمنع مهمة تسليم لجمعية A تشير إلى مستفيد جمعية B.
  beneficiary       Beneficiary     @relation(fields: [beneficiaryId, associationId], references: [id, associationId])
  association       Association     @relation(fields: [associationId], references: [id])
  /// NOTE: مطابقة الجمعية للمندوب المُعيَّن (delegateAccountId) تبقى
  /// Service-level فقط (لم تُطلَب composite FK لها صراحة في هذه المرحلة؛
  /// accounts.association_id nullable أصلًا لأن ADMIN بلا جمعية) — راجع
  /// بند 8 في تقرير الإغلاق.
  delegate          Account?        @relation("MissionDelegate", fields: [delegateAccountId], references: [id])
  attempts          DeliveryAttempt[]

  @@index([delegateAccountId, status])
  @@index([associationId, status])
  @@map("delivery_missions")
}

// ============================================================
// 18) delivery_attempts (append-only، تمثل ورقة "التسليمات")
// ============================================================
model DeliveryAttempt {
  id                        String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  publicCode                String                 @unique @map("public_code")
  missionId                 String                 @map("mission_id") @db.Uuid
  beneficiaryId              String                @map("beneficiary_id") @db.Uuid
  delegateAccountId           String               @map("delegate_account_id") @db.Uuid

  status                       DeliveryStatus       @map("status")
  failureReason                  DeliveryFailureReason? @map("failure_reason")
  notes                            String?

  proofFileId                       String?         @map("proof_file_id") @db.Uuid
  recipientSignatureFileId             String?      @map("recipient_signature_file_id") @db.Uuid

  attemptedAt                            DateTime   @map("attempted_at")
  createdAt                                DateTime @default(now()) @map("created_at")

  mission       DeliveryMission @relation(fields: [missionId], references: [id])
  beneficiary   Beneficiary     @relation(fields: [beneficiaryId], references: [id])
  delegate      Account         @relation("AttemptDelegate", fields: [delegateAccountId], references: [id])
  proofFile     FileObject?     @relation("AttemptProofFile", fields: [proofFileId], references: [id])
  signatureFile FileObject?     @relation("AttemptSignatureFile", fields: [recipientSignatureFileId], references: [id])

  @@index([missionId])
  @@map("delivery_attempts")
}

