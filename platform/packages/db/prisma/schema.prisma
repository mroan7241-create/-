// ============================================================
// 25) password_reset_tokens (NODE-1)
// ============================================================
/// يستبدل CacheService القديم (passwordResetCacheKey_) بجدول حقيقي
/// durable. لا يُخزَّن الرمز الخام أبدًا — token_hash فقط (SHA-256).
/// TTL = 15 دقيقة (PASSWORD_RESET_TTL_SECONDS القديم)، MAX محاولات = 6
/// (PASSWORD_RESET_MAX_ATTEMPTS القديم). راجع AUTHENTICATION.md.
model PasswordResetToken {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId       String    @map("account_id") @db.Uuid
  emailNormalized String    @map("email_normalized")
  tokenHash       String    @map("token_hash")
  attemptCount    Int       @default(0) @map("attempt_count")
  expiresAt       DateTime  @map("expires_at")
  consumedAt      DateTime? @map("consumed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ============================================================
// 26) auth_rate_limits (NODE-1)
// ============================================================
/// حدّ معدَّل دائم (DB-backed) يعمل بشكل صحيح عبر أكثر من instance —
/// يستبدل throttle_ القديم المبني على CacheService (لا يصلح لأكثر من
/// عملية Node.js واحدة). subject_hash = HMAC للمعرِّف (بريد/رمز مندوب)
/// — لا يُخزَّن المعرِّف الخام. راجع AUTHENTICATION.md لقسم "Rate limiting".
model AuthRateLimit {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  scope           String
  subjectHash     String   @map("subject_hash")
  windowStartedAt DateTime @map("window_started_at")
  attemptCount    Int      @default(0) @map("attempt_count")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([scope, subjectHash])
  @@index([expiresAt])
  @@map("auth_rate_limits")
}

// ============================================================
// 27) public_code_counters (NODE-2)
// ============================================================
/// مولّد publicCode متزامن ذرّي — يستبدل منطق nextId_/SELECT MAX(...)+1
/// القديم المبني على Google Sheets (غير آمن أصلًا تحت التزامن الحقيقي).
/// صف واحد لكل بادئة (APP/ASC/USR/BEN/NED/DEV/MND/RCB/...)؛ `nextPublicCode(tx, prefix)`
/// في apps/api ينفّذ `INSERT ... ON CONFLICT (prefix) DO UPDATE SET
/// next_value = next_value + 1 RETURNING next_value` — عبارة SQL واحدة
/// ذرّية بذاتها، آمنة تحت التزامن العالي بلا الحاجة لقفل صريح إضافي،
/// ويجب استدعاؤها دائمًا داخل نفس transaction التي تُنشئ السجل المُرقَّم
/// حتى يتراجع الرقم مع تراجع العملية بالكامل عند الفشل. راجع
/// LEGACY_DATA_MIGRATION.md لخطة NODE-8 لمصالحة/تقديم العداد بعد استيراد
/// أرقام Legacy القديمة لمنع أي تصادم.
model PublicCodeCounter {
  prefix    String   @id
  nextValue Int      @default(1) @map("next_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("public_code_counters")
}
